
@model List<SAC.Models.BancoCuentaModelView>

@{
    ViewBag.Title = "Cuentas Bancarias";
    Layout = "~/Views/Shared/_Layout.cshtml";

}



@using (Html.BeginForm("Index", "BancoCuenta", FormMethod.Post, new { novalidate = true }))


{
    @Html.AntiForgeryToken()



    List<SelectListItem> ListaBancos = (List<SelectListItem>)ViewBag.CargarBanco;




    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">Gestión de Cuentas Bancarias</h4>

                        <div class="table-responsive m-t-10">

                            @Html.ActionLink("Nueva cuenta", "Agregar", "Banco", new { @class = "btn btn-secondary btn-sm m-t-10" })

                            <table id="tblPais" class="display nowrap table table-hover table-striped table-bordered m-t-10" cellspacing="0" width="100%">
                                <thead>
                                    <tr>
                                        <th>Codigo</th>
                                        <th>Banco</th>
                                        <th>Descripcion</th>
                                        <th>Imputacion</th>
                                        <th>Operaciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@Html.DisplayFor(modelItem => item.Codigo)</td>
                                            <td>@Html.DisplayFor(modelItem => item.Banco.Nombre)</td>
                                            <td>@Html.DisplayFor(modelItem => item.BancoDescripcion)</td>
                                            <td>@Html.DisplayFor(modelItem => item.IdImputacion)</td>
                                            <td>
                                                @Html.ActionLink(" ", "Editar", "Banco", new { _id = @item.Id }, new { @class = "btn btn-primary fa fa-pencil-square-o" })
                                                @Html.ActionLink(" ", "Eliminar", "Banco", new { _id = @item.Id }, new { @class = "btn btn-danger fa fa-trash-o", onclick = "AsigarConfirmacion(" + @item.Id + ")" })

                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>


                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}

<div class="modal fade" id="ModalConfirmacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Aviso</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <h3> ¿Está seguro que desea eliminar la Cuenta?</h3>
            </div>


            <div style="padding:1em;">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" onclick="Eliminar()" class="btn btn-primary">Aceptar</button>

            </div>
        </div>
    </div>
</div>

@* crea un formulario para ir al controlador *@
@using (Html.BeginForm("Eliminar", "Banco", FormMethod.Post, new { @id = "frmEliminar" }))
{
    @Html.Hidden("IdCuenta");
}


<script>
    function AsigarConfirmacion(cuenta) {
        event.preventDefault();
        document.getElementById("IdCuenta").value = cuenta;        
        $("#ModalConfirmacion").modal('show');
    }
    
    function Eliminar() {
        var frmEliminar = document.getElementById("frmEliminar");
        frmEliminar.submit();
    }

</script>

@section Scripts {


    <!-- Date Picker Plugin JavaScript -->
    <script src="/Content/assets/plugins/bootstrap-datepicker/bootstrap-datepicker.js"></script>
    <script src="~/Scripts/view/DatePickerReady.js"></script>
    <!-- This is data table -->
    <script src="/Content/assets/plugins/datatables/jquery.dataTables.min.js"></script>
    <!-- start - This is for export functionality only -->
    <script src="~/Content/assets/plugins/datatables/jsTable/dataTables.buttons.min.js"></script>
    <script src="~/Content/assets/plugins/datatables/jsTable/buttons.flash.min.js"></script>
    <script src="~/Content/assets/plugins/datatables/jsTable/jszip.min.js"></script>
    <script src="~/Content/assets/plugins/datatables/jsTable/pdfmake.min.js"></script>
    <script src="~/Content/assets/plugins/datatables/jsTable/vfs_fonts.js"></script>
    <script src="~/Content/assets/plugins/datatables/jsTable/buttons.html5.min.js"></script>
    <script src="~/Content/assets/plugins/datatables/jsTable/buttons.print.min.js"></script>

    <script src="~/Scripts/view/TarjetaScript.js"></script>



}

